@page "/admin"
@page "/admin/process-participants"
@using TestMaster.Presentation.Services
@layout AdminLayout
@inject IBlankNumberService BlankService
@inject IFilePickerService FilePicker

<div class="admin-page">
    <div class="page-header">
        <h1>Обработка файла участников</h1>
        <p class="page-description">Загрузите Excel файл с ФИО и школами, система добавит коды бланков</p>
    </div>
    
    <div class="content-card">
        <div class="form-section">
            <h3>Загрузка файла</h3>
            
            <div class="file-info">
                <h4>📋 Требуемый формат файла:</h4>
                <div class="format-example">
                    <p><strong>Столбец A:</strong> ФИО участника</p>
                    <p><strong>Столбец B:</strong> Школа/Учреждение</p>
                    <p><strong>Столбец C:</strong> Код бланка (будет заполнен автоматически)</p>
                </div>
                <p style="margin-top: 10px; color: #999;">Пример:</p>
                <div class="example-table">
                    <div class="table-row header-row">
                        <div class="table-cell">ФИО</div>
                        <div class="table-cell">Школа</div>
                        <div class="table-cell">Код бланка</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell">Иван Иванович Иванов</div>
                        <div class="table-cell">МКОУ СОШ №27</div>
                        <div class="table-cell" style="color: #28a745;">2 832503 190000</div>
                    </div>
                    <div class="table-row">
                        <div class="table-cell">Петр Петрович Петров</div>
                        <div class="table-cell">Гимназия №47</div>
                        <div class="table-cell" style="color: #28a745;">2 832503 190001</div>
                    </div>
                </div>
            </div>
            
            <div style="margin-top: 30px;">
                <button class="btn btn-primary btn-large" @onclick="SelectAndProcessFile" disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <span>Обработка...</span>
                    }
                    else
                    {
                        <span>📁 Выбрать и обработать файл</span>
                    }
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success">
                    <strong>✓</strong> @_successMessage
                </div>
            }
            
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-error">
                    <strong>✗</strong> @_errorMessage
                </div>
            }
        </div>
        
        <div class="info-section">
            <h3>Информация</h3>
            <ul class="info-list">
                <li><strong>Входной формат:</strong> .xlsx или .xls</li>
                <li><strong>Формат кода:</strong> 2 832503 19****</li>
                <li><strong>Максимум участников:</strong> 10 000</li>
                <li><strong>Результат:</strong> Исходный файл с заполненным столбцом C</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private bool _isProcessing;
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task SelectAndProcessFile()
    {
        try
        {
            _isProcessing = true;
            _successMessage = string.Empty;
            _errorMessage = string.Empty;
            StateHasChanged();

            var filePath = await FilePicker.PickExcelFileAsync();
            
            if (string.IsNullOrEmpty(filePath))
            {
                // Пользователь отменил выбор
                return;
            }

            var resultPath = await BlankService.ProcessParticipantsFileAsync(filePath);
            
            if (resultPath != null)
            {
                _successMessage = $"Файл успешно обработан: {resultPath}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }
}



