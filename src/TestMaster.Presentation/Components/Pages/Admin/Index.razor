@page "/admin"
@using TestMaster.Presentation.Services
@layout AdminLayout
@inject IBlankNumberService BlankService

<div class="admin-page">
    <div class="page-header">
        <h1>Генерация номеров бланков</h1>
        <p class="page-description">Генерация номеров бланков в формате: 2 832503 19****</p>
    </div>
    
    <div class="content-card">
        <div class="form-section">
            <h3>Параметры генерации</h3>
            
            <div class="form-group">
                <label>Количество бланков (от 1 до 10 000)</label>
                <input type="number" 
                       @bind="_count" 
                       min="1" 
                       max="10000" 
                       class="form-control" 
                       placeholder="Введите количество" />
            </div>
            
            <div class="preview-section">
                <h4>Пример первых 5 номеров:</h4>
                <div class="preview-list">
                    @foreach (var number in GetPreview())
                    {
                        <div class="preview-item">@number</div>
                    }
                </div>
            </div>
            
            <div class="button-group">
                <button class="btn btn-success" @onclick="GenerateExcel" disabled="@_isGenerating">
                    @if (_isGenerating)
                    {
                        <span>Генерация...</span>
                    }
                    else
                    {
                        <span>📊 Сгенерировать в Downloads</span>
                    }
                </button>
                <button class="btn btn-primary" @onclick="GenerateExcelWithPicker" disabled="@_isGenerating">
                    @if (_isGenerating)
                    {
                        <span>Генерация...</span>
                    }
                    else
                    {
                        <span>📁 Выбрать папку и сгенерировать</span>
                    }
                </button>
            </div>
            
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success">
                    <strong>✓</strong> @_successMessage
                </div>
            }
            
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-error">
                    <strong>✗</strong> @_errorMessage
                </div>
            }
        </div>
        
        <div class="info-section">
            <h3>Информация</h3>
            <ul class="info-list">
                <li><strong>Формат:</strong> 2 832503 19****</li>
                <li><strong>Диапазон:</strong> от 2 832503 190000 до 2 832503 199999</li>
                <li><strong>Максимум:</strong> 10 000 уникальных номеров</li>
                <li><strong>Выходной файл:</strong> Excel (.xlsx)</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private int _count = 100;
    private bool _isGenerating;
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private List<string> GetPreview()
    {
        try
        {
            var previewCount = Math.Min(5, Math.Max(1, _count));
            return BlankService.GenerateBlankNumbers(previewCount);
        }
        catch
        {
            return new List<string> { "2 832503 190000", "2 832503 190001", "2 832503 190002", "2 832503 190003", "2 832503 190004" };
        }
    }

    private async Task GenerateExcel()
    {
        if (_count < 1 || _count > 10000)
        {
            _errorMessage = "Количество должно быть от 1 до 10 000";
            return;
        }

        try
        {
            _isGenerating = true;
            _successMessage = string.Empty;
            _errorMessage = string.Empty;
            StateHasChanged();

            var filePath = await BlankService.GenerateBlankNumbersExcelAsync(_count);
            
            _successMessage = $"Файл успешно создан: {filePath}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при генерации: {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task GenerateExcelWithPicker()
    {
        if (_count < 1 || _count > 10000)
        {
            _errorMessage = "Количество должно быть от 1 до 10 000";
            return;
        }

        try
        {
            _isGenerating = true;
            _successMessage = string.Empty;
            _errorMessage = string.Empty;
            StateHasChanged();

            var filePath = await BlankService.GenerateBlankNumbersExcelWithPickerAsync(_count);
            
            if (filePath == null)
            {
                // Пользователь отменил выбор - молча закрываем, без сообщения об ошибке
            }
            else
            {
                _successMessage = $"Файл успешно создан: {filePath}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при генерации: {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }
}



