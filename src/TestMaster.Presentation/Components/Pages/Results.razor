@page "/results"
@using TestMaster.Presentation.Services
@layout MainLayout
@inject NavigationManager NavigationManager
@inject IExamStateService ExamState
@inject IConnectivityService ConnectivityService
@inject IExamResultService ExamResultService
@inject IExamDataService ExamData

<div class="header-bar">
    <div class="header-title">Единый государственный экзамен Информатика и ИКТ (КЕГЭ)</div>
</div>

<div class="main-content" style="padding: 20px;">
    <h2 style="text-align: center; margin-bottom: 30px;">Результаты экзамена</h2>

    @{
        var primaryScore = CalculatePrimaryScore();
        var secondaryScore = ConvertToSecondary(primaryScore);
        var maxPrimary = ExamData.MaxPrimaryScore;
        var maxSecondary = ExamData.MaxSecondaryScore;
    }

    <!-- Блок "X/100" (вторичный балл) -->
    <div style="text-align: center; margin-bottom: 20px;">
        <div style="font-size: 64px; font-weight: bold; color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.3);">
            @secondaryScore/@maxSecondary
        </div>
        <div style="color: #aaa; font-size: 16px; margin-top: 8px;">
            Первичный балл: @primaryScore/@maxPrimary
        </div>
    </div>

    <table class="results-table">
        <thead>
        <tr>
            <th>№</th>
            <th>Балл</th>
            <th>Ваш ответ</th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 1; i <= ExamData.TotalTasks; i++)
        {
            var userAnswer = ExamState.Answers.GetValueOrDefault(i, "");
            var (score, _) = GetScoreAndCorrectAnswer(i, userAnswer);
            <tr>
                <td>@i</td>
                <td>@score</td>
                <td>@FormatAnswer(userAnswer)</td>
            </tr>
        }
        </tbody>
    </table>

    <div style="text-align: center; margin-top: 20px;">
        <button class="btn btn-danger" @onclick="FinishExam" disabled="@_isSaving">
            @_finishButtonText
        </button>

        @if (!string.IsNullOrEmpty(_saveMessage))
        {
            <div style="margin-top: 12px; color: @(_saveSuccess ? "#28a745" : "#ff6b7a"); font-size: 14px;">
                @_saveMessage
            </div>
        }
    </div>
</div>

@code {
    private bool _isSaving;
    private string _finishButtonText = "Завершить экзамен";
    private string _saveMessage = string.Empty;
    private bool _saveSuccess;


    private int CalculatePrimaryScore()
    {
        return ExamData.CalculatePrimaryScore(ExamState.Answers);
    }

    private int ConvertToSecondary(int primary)
    {
        return ExamData.ConvertToSecondary(primary);
    }

    private (int score, string correct) GetScoreAndCorrectAnswer(int taskId, string userAnswer)
    {
        return ExamData.CalculateTaskScore(taskId, userAnswer);
    }

    private static string FormatAnswer(string answer)
    {
        if (string.IsNullOrEmpty(answer))
        {
            return "—";
        }

        return answer.Contains(",") ? string.Join(", ", answer.Split(',')) : answer;
    }

    private async Task FinishExam()
    {
        _isSaving = true;
        _finishButtonText = "Сохранение...";
        _saveMessage = string.Empty;
        StateHasChanged();

        // Проверяем наличие данных студента
        if (ExamState.Student == null)
        {
            _saveMessage = "⚠️ Не удалось сохранить результаты: данные студента отсутствуют";
            _saveSuccess = false;
            _isSaving = false;
            _finishButtonText = "Завершить экзамен";
            StateHasChanged();

            await Task.Delay(3000);
            NavigationManager.NavigateTo("/");
            return;
        }

        // Сохраняем результаты
        var saveResult = await ExamResultService.SaveResultsAsync(ExamState.Student, ExamState.Answers);

        if (saveResult.Success)
        {
            _saveMessage = "✓ Результаты успешно сохранены";
            _saveSuccess = true;
            StateHasChanged();

            // Запускаем проверку интернета в фоне
            _ = ConnectivityService.CheckUntilConnectedAsync(async () =>
            {
                await Task.CompletedTask;
                Console.WriteLine("Интернет восстановлен! Результаты можно отправить.");
            });

            await Task.Delay(2000);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            if (saveResult.IsPermissionError)
            {
                _saveMessage = $"⚠️ Нет прав на запись файла. Обратитесь к администратору.\n{saveResult.Error}";
                _saveSuccess = false;
                StateHasChanged();

                await Task.Delay(5000);
                NavigationManager.NavigateTo("/");
            }
            else
            {
                _saveMessage = $"✗ Ошибка сохранения: {saveResult.Error}";
                _saveSuccess = false;
                _isSaving = false;
                _finishButtonText = "Попробовать снова";
                StateHasChanged();
            }
        }
    }

}