@page "/"
@using TestMaster.Presentation.Services
@layout MainLayout
@inject NavigationManager NavigationManager
@inject IExamStateService ExamState
@inject IExamResultService ExamResultService

<div class="login-container"
     style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: calc(100vh - 50px); padding: 20px;">
    <h1 class="header-title" style="color: white; text-align: center; margin-bottom: 30px;">
        Единый государственный экзамен Информатика и ИКТ
    </h1>

    <div style="background: #2d2d3d; padding: 25px; border-radius: 8px; width: 100%; max-width: 600px;">
        <p style="margin-bottom: 20px; color: #aaa;">Введите ваш ID из файла участников</p>

        <div style="display: flex; margin-bottom: 20px;">
            <input type="text"
                   @bind-value="_studentId"
                   @bind-value:event="oninput"
                   class="answer-input"
                   placeholder="Введите ID"
                   style="width: 100%;"/>
        </div>

        <p style="font-size: 14px; color: #aaa; margin-bottom: 20px;">Введите ваш ID</p>

        <div style="display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" @onclick="GoToExamAsync" disabled="@(!IsFormValid() || _isLoading)">
                @_continueText
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div style="margin-top: 12px; color: #ff6b7a; font-size: 14px;">
                @_errorMessage
            </div>
        }

        <div style="margin-top: 20px; text-align: center; padding-top: 15px; border-top: 1px solid #444;">
            <a href="/admin/login" style="color: #28a745; text-decoration: none; font-size: 14px;">
                🔒 Вход в админ панель
            </a>
        </div>
    </div>
</div>

@code {
    private string _studentId = string.Empty;

    private string _errorMessage = string.Empty;
    private bool _isLoading;
    private string _continueText = "Далее";

    private bool IsFormValid()
    {
        return !string.IsNullOrWhiteSpace(_studentId);
    }

    private async Task GoToExamAsync()
    {
        if (!IsFormValid())
        {
            return;
        }

        _isLoading = true;
        _errorMessage = string.Empty;
        _continueText = "Проверка...";
        StateHasChanged();

        var lookup = await ExamResultService.TryLoadStudentAsync(_studentId);

        if (!lookup.Success || lookup.Student == null)
        {
            _errorMessage = lookup.Error ?? "Не удалось проверить ID";
            _isLoading = false;
            _continueText = "Далее";
            StateHasChanged();
            return;
        }

        ExamState.BlankNumber = lookup.Student.BlankNumber;
        ExamState.Student = lookup.Student;

        _isLoading = false;
        _continueText = "Далее";
        NavigationManager.NavigateTo("/exam/info");
    }

}