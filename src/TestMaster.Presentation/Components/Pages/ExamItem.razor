@page "/exam/{id:int}"
@using TestMaster.Presentation.Services
@layout ExamLayout
@inject IExamStateService ExamState
@inject NavigationManager NavigationManager

<div class="task-header">
    Задание @Id (@GetTaskId())
</div>

<div class="task-body">
    @((MarkupString)GetTaskText())
</div>

@if (IsMultiInput(Id))
{
    <div class="kege-table-wrapper">
        <div class="table-header">Введите или скопируйте свой ответ в поля таблицы</div>

        @switch (Id)
        {
            case 17:
            case 18:
            case 20:
            case 26:
                <table class="kege-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>1</th>
                            <th>2</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-number">1</td>
                            <td><input type="text" @bind-value="_multiAnswer[0]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                            <td><input type="text" @bind-value="_multiAnswer[1]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                        </tr>
                    </tbody>
                </table>
                break;

            case 27:
                <table class="kege-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>1</th>
                            <th>2</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-number">1</td>
                            <td><input type="text" @bind-value="_multiAnswer[0]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                            <td><input type="text" @bind-value="_multiAnswer[1]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                        </tr>
                        <tr>
                            <td class="row-number">2</td>
                            <td><input type="text" @bind-value="_multiAnswer[2]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                            <td><input type="text" @bind-value="_multiAnswer[3]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                        </tr>
                    </tbody>
                </table>
                break;

            case 25:
                <table class="kege-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>1</th>
                            <th>2</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < 5; i++)
                        {
                            var index = i;
                            <tr>
                                <td class="row-number">@(index + 1)</td>
                                <td><input type="text" @bind-value="_multiAnswer[index * 2]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                                <td><input type="text" @bind-value="_multiAnswer[index * 2 + 1]" @oninput="OnMultiAnswerChanged" class="kege-cell" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                break;
        }

        <div class="answer-buttons">
            <button class="btn btn-outline" @onclick="ClearMultiAnswer">Очистить</button>
            <button class="btn btn-primary" 
                    @onclick="SaveMultiAnswer"
                    disabled="@_isAnswerSaved">
                @_saveButtonText
            </button>
        </div>
    </div>
}
else
{
    <div class="answer-section single-input">
        <input type="text" 
               @bind-value="_currentAnswer" 
               @oninput="OnAnswerChanged"
               class="answer-input" 
               placeholder="Введите ответ"/>
        <button class="btn btn-success" 
                @onclick="SaveAnswer"
                disabled="@_isAnswerSaved">
            @_saveButtonText
        </button>
        <button class="btn btn-outline" @onclick="ClearAnswer">Очистить</button>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private string _currentAnswer = string.Empty;
    private readonly string[] _multiAnswer = new string[20];
    
    private bool _isAnswerSaved = false;
    private string _saveButtonText = "Сохранить ответ";

    protected override void OnParametersSet()
    {
        if (Id is < 1 or > 27)
        {
            NavigationManager.NavigateTo("/exam/1", replace: true);
            return;
        }

        _currentAnswer = "";
        Array.Clear(_multiAnswer, 0, _multiAnswer.Length);

        if (!ExamState.Answers.TryGetValue(Id, out var saved)) return;
        if (IsMultiInput(Id))
        {
            var parts = saved.Split(',');
            for (var i = 0; i < Math.Min(parts.Length, _multiAnswer.Length); i++)
                _multiAnswer[i] = parts[i];
        }
        else
        {
            _currentAnswer = saved;
        }
    }

    private static bool IsMultiInput(int id)
    {
        return id is 17 or 18 or 20 or 25 or 26 or 27;
    }

    private string GetTaskId()
    {
        return Id switch
        {
            1 => "№23738",
            24 => "№23762",
            _ => $"№{Id * 100 + 123}"
        };
    }

    private string GetTaskText()
    {
        var imagePath = $"/images/task{Id}.png";

        return $"""
                <div class="task-image-container">
                    <img src="/images/task{Id}.png" class="task-image" alt="Задание {Id}" />
                </div>
                {GetFileLinks()}
                <p class="task-description">Ответ вводится ниже.</p>
                """;
    }
    
    private string GetFileLinks()
    {
        var links = new List<string>();

        switch (Id)
        {
            case 3:
                links.Add($"<a href='/files/{Id}.ods' download='{Id}.ods' class='file-link'>📄 {Id}.ods</a>");
                break;
            case 9:
            case 18:
                links.Add($"<a href='/files/{Id}.xlsx' download='{Id}.xlsx' class='file-link'>📄 {Id}.xlsx</a>");
                break;
            case 22:
                links.Add($"<a href='/files/{Id}.ods' download='{Id}.ods' class='file-link'>📄 {Id}.ods</a>");
                break;
            case 10:
                links.Add($"<a href='/files/{Id}.doc' download='{Id}.doc' class='file-link'>📄 {Id}.doc</a>");
                break;
            case 17:
            case 24:
            case 26:
                links.Add($"<a href='/files/{Id}.txt' download='{Id}.txt' class='file-link'>📄 {Id}.txt</a>");
                break;
            case 27:
                links.Add($"<a href='/files/27_A.txt' download='27_A.txt' class='file-link'>📄 27_A.txt</a>");
                links.Add($"<a href='/files/27_B.txt' download='27_B.txt' class='file-link'>📄 27_B.txt</a>");
                break;
        }

        return links.Any() ? $"<div class='file-links'>{string.Join(" ", links)}</div>" : "";
    }

    private void OnAnswerChanged(ChangeEventArgs e)
    {
        if (_isAnswerSaved)
        {
            _isAnswerSaved = false;
            _saveButtonText = "Сохранить ответ";
            StateHasChanged();
        }
    }

    private void OnMultiAnswerChanged(ChangeEventArgs e)
    {
        if (_isAnswerSaved)
        {
            _isAnswerSaved = false;
            _saveButtonText = "Сохранить ответ";
            StateHasChanged();
        }
    }

    private async Task SaveAnswer()
    {
        if (!string.IsNullOrWhiteSpace(_currentAnswer))
        {
            ExamState.Answers[Id] = _currentAnswer.Trim();
            _isAnswerSaved = true;
            _saveButtonText = "Ответ сохранён";
            StateHasChanged();
        }
    }

    private async Task SaveMultiAnswer()
    {
        var count = Id switch
        {
            25 => 10,
            27 => 4,
            _ => 2
        };

        var parts = new List<string>();
        for (var i = 0; i < count; i++)
            parts.Add((_multiAnswer[i] ?? "").Trim());

        var answer = string.Join(",", parts);
        ExamState.Answers[Id] = answer;

        _isAnswerSaved = true;
        _saveButtonText = "Ответ сохранён";
        StateHasChanged();
    }

    private void ClearAnswer()
    {
        _currentAnswer = "";
        ExamState.Answers.Remove(Id);
        _isAnswerSaved = false;
        _saveButtonText = "Сохранить ответ";
        StateHasChanged();
    }

    private void ClearMultiAnswer()
    {
        var count = Id switch
        {
            25 => 10,
            27 => 4,
            _ => 2
        };
        for (int i = 0; i < count; i++)
            _multiAnswer[i] = "";

        ExamState.Answers.Remove(Id);
        _isAnswerSaved = false;
        _saveButtonText = "Сохранить ответ";
        StateHasChanged();
    }
}