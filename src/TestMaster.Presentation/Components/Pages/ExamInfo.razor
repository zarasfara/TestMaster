@page "/exam/info"
@using TestMaster.Presentation.Services
@layout ExamLayout

<div class="task-header">
    <h1>Информация об экзамене</h1>
</div>

<div class="task-body exam-info-container">
    <div class="exam-info-card">
        <h2>ЕГЭ по информатике и ИКТ</h2>
        
        <div>
            <p><strong>27 заданий</strong> • <strong>235 минут</strong> (3 часа 55 минут)</p>
            <p><strong>Задания 1–23:</strong> Ответы в виде числа или символов</p>
            <p><strong>Задания 24–27:</strong> Написание программы или обработка файла</p>
        </div>
        
        <div class="exam-info-highlight" style="margin: 20px 0;">
            <p>⚠️ Внимательно проверяйте ответы перед сохранением! Используйте номера заданий в левой панели для навигации.</p>
        </div>
        
        <div style="margin-top: 25px;">
            <h3 style="margin-bottom: 15px; text-align: center; color: #fff;">Скачать файлы заданий</h3>
            <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
                <button class="btn btn-primary" @onclick="DownloadAllFiles" disabled="@_isDownloading">
                    @if (_isDownloading)
                    {
                        <span>Скачивание...</span>
                    }
                    else
                    {
                        <span>Скачать в Downloads</span>
                    }
                </button>
                <button class="btn btn-success" @onclick="DownloadAllFilesWithPicker" disabled="@_isDownloading">
                    @if (_isDownloading)
                    {
                        <span>Скачивание...</span>
                    }
                    else
                    {
                        <span>📁 Выбрать папку</span>
                    }
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_downloadMessage))
            {
                <div style="margin-top: 10px; padding: 10px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px; color: #155724; font-size: 14px; text-align: center;">
                    <strong>✓</strong> @_downloadMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="margin-top: 10px; padding: 10px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 5px; color: #721c24; font-size: 14px; text-align: center;">
                    <strong>✗</strong> @_errorMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Inject] private IFileDownloadService FileDownloadService { get; set; } = null!;

    private bool _isDownloading;
    private string _downloadMessage = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task DownloadAllFiles()
    {
        try
        {
            _isDownloading = true;
            _downloadMessage = string.Empty;
            _errorMessage = string.Empty;
            StateHasChanged();

            var downloadsPath = await FileDownloadService.DownloadAllExamFilesAsync();
            
            _downloadMessage = $"Файлы успешно скачаны в папку: {downloadsPath}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при скачивании файлов: {ex.Message}";
            Console.WriteLine($"Ошибка при скачивании файлов: {ex.Message}");
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAllFilesWithPicker()
    {
        try
        {
            _isDownloading = true;
            _downloadMessage = string.Empty;
            _errorMessage = string.Empty;
            StateHasChanged();

            var downloadsPath = await FileDownloadService.DownloadAllExamFilesWithPickerAsync();
            
            if (downloadsPath != null)
            {
                _downloadMessage = $"Файлы успешно скачаны в папку: {downloadsPath}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка при скачивании файлов: {ex.Message}";
            Console.WriteLine($"Ошибка при скачивании файлов: {ex.Message}");
        }
        finally
        {
            _isDownloading = false;
            StateHasChanged();
        }
    }
}